# Application Environment
APP_ENV=development
NODE_ENV=development
LOG_LEVEL=info

# PostgreSQL Databases
POSTGRES_USER=delivery
POSTGRES_PASSWORD=delivery-dev-password
DB_NAME=delivery_user_db
NOTIFICATION_DB_NAME=delivery_notification_db
PAYMENT_DB_NAME=payment_db

# Authentication & Security
JWT_SECRET=your-secure-jwt-secret-key-change-in-production
JWT_EXPIRE=36000s

# Redis
REDIS_HOST=redis-srv
REDIS_PORT=6379
REDIS_DB=0

# Message Brokers
NATS_URL=nats://nats-srv:4222
KAFKA_BROKERS=kafka-srv:9092
RABBITMQ_USER=delivery
RABBITMQ_PASSWORD=delivery-dev-password
RABBITMQ_VHOST=/
RABBITMQ_URL=amqp://delivery:delivery-dev-password@rabbitmq-srv:5672/
RABBITMQ_MANAGEMENT_URL=http://rabbitmq-srv:15672

# Inter-Service gRPC Endpoints
MEDIA_SERVICE_GRPC_URL=media-srv:50052

# AWS / LocalStack Object Storage & DynamoDB
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT=http://localstack-srv:4566
DYNAMODB_ENDPOINT=http://localstack-srv:4566
S3_BUCKET_NAME=delivery-media-development

# Notification Providers (Optional in local dev)
EMAIL_SERVICE=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
SENDGRID_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TELEGRAM_BOT_TOKEN=

# Payment Service & Stripe
PORT_PAYMENT_GRAPHQL=4002
PORT_PAYMENT_GRPC=50056
PORT_PAYMENT_METRICS=9106
PORT_PAYMENT_WEBHOOK=4012
STRIPE_API_VERSION=2024-04-10
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# Observability, Prometheus, Alertmanager & Discord Relay
ALERT_WEBHOOK_URL=http://alertmanager-discord:8080/webhook
DISCORD_WEBHOOK_URL=https://discordapp.com/api/webhooks/your-discord-webhook-id/your-token
ALERTMANAGER_URL=http://alertmanager:9093
