{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": "test/.*.e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "transformIgnorePatterns": [
    "node_modules/(?!(@nestjs|typeorm|@bts-soft)/)"
  ],
  "setupFilesAfterFramework": [
    "test/jest-e2e-setup.ts"
  ]
}
